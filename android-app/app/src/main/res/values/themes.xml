<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme — no action bar, navy status/nav bars. -->
    <style name="Theme.KSPowerWashing" parent="Theme.AppCompat.NoActionBar">
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash screen theme (AndroidX SplashScreen API).
         The activity uses this; it switches to Theme.KSPowerWashing once loaded. -->
    <style name="Theme.KSPowerWashing.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/navy_mid</item>
        <item name="postSplashScreenTheme">@style/Theme.KSPowerWashing</item>
    </style>

</resources>
